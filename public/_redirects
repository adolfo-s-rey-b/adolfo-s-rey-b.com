# Redirects 301 de Cloudflare Pages (§4.2).
# Cloudflare evalúa en orden y la PRIMERA coincidencia gana, así que las reglas
# splat van antes que las genéricas.
# Límites de Pages: 2100 reglas estáticas / 100 dinámicas.

# ── /github/ pasa a ser /code/ ──────────────────────────────────────────────
# Dos variantes porque Cloudflare solo normaliza la barra final cuando el asset
# existe, y /github ya no existe.
/github                         /code/                                301
/github/                        /code/                                301

# ── Notas de clase a slugs en inglés ────────────────────────────────────────
# El splat va primero: cubre las lecciones profundas, que son las realmente
# enlazadas. Los nombres de archivo de las lecciones no cambiaron.
/notes/teoria-juegos/*          /notes/class/game-theory/:splat       301
/notes/macroeconomia/*          /notes/class/macroeconomics/:splat    301
/notes/microeconomia/*          /notes/class/microeconomics/:splat    301
/notes/macroeconomia            /notes/class/macroeconomics/          301

# Game Theory y Microeconomics III todavía no tienen lecciones en la bóveda, así
# que no se generan sus páginas y estas dos reglas apuntarían a un 404 — mala
# señal para un lector y para Google. Van al índice mientras tanto.
# RESTAURAR a /notes/class/game-theory/ y /notes/class/microeconomics/ en cuanto
# haya notas: el índice las vuelve a listar solo, sin tocar código.
/notes/teoria-juegos            /notes/                               301
/notes/microeconomia            /notes/                               301

# ── Blog ────────────────────────────────────────────────────────────────────
# /blog/ vuelve a ser una ruta real: las notas de clase (/notes/) y los
# escritos (/blog/) son cosas distintas y tienen índices separados.
# NO reintroducir aquí una regla /blog/* → /notes/: dejaría el blog inalcanzable.
#
# Las dos entradas de demo se reescribieron con slugs nuevos en inglés.
/blog/regulacion-fintech/       /blog/colombia-mandatory-open-finance/   301
/blog/machine-learning-salud/   /blog/two-methods-disease-clusters/      301

